# ログイン認証情報の設定ファイル（サンプル / テンプレート）
#
# このファイル自体はダミーです。実際のパスワードは:
#   - ローカル開発: 同じフォルダに `secrets.toml` を作成して記入（.gitignoreで除外済み）
#   - Streamlit Cloud: アプリ設定の「Secrets」欄に直接ペースト
#
# 注意: このファイルに実際のパスワードを書かないでください。
#       GitHub 上に公開されるリスクがあります。

[passwords]
"user1@example.com" = "CHANGE_ME_password1"
"user2@example.com" = "CHANGE_ME_password2"
"user3@example.com" = "CHANGE_ME_password3"
"user4@example.com" = "CHANGE_ME_password4"
"user5@example.com" = "CHANGE_ME_password5"
